# Optional. Without a key, the complete screening flow runs in deterministic demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local SQLite location (defaults to ./data/yourhr.sqlite)
# DATABASE_PATH=./data/yourhr.sqlite
# Optional controls for a future hardened deployment (not sufficient on their own):
# DISABLE_DEMO=true
# SECURE_COOKIES=true

# Public static trial: set ONLY after applying the migration and configuring
# email delivery + verified signup. These are public browser configuration,
# never a Supabase service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vite sets NEXT_PUBLIC_STATIC_TRIAL=true for the hosted static build.
